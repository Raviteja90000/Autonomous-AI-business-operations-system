# Autonomous AI Business Operations Manager Configuration

# Application & Environment
APP_NAME="Autonomous AI Business Operations Manager"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# Production PostgreSQL example: postgresql+asyncpg://postgres:postgres@localhost:5432/ai_ops_manager
# Development SQLite async fallback: sqlite+aiosqlite:///./ai_ops_manager.db
DATABASE_URL=sqlite+aiosqlite:///./ai_ops_manager.db
DATABASE_ECHO=false

# Autonomy & Guardrails Defaults
DEFAULT_AUTONOMY_TIER=2
MAX_AUTONOMOUS_SPEND_USD=5000.00
MAX_BLAST_RADIUS_ENTITIES=10
MIN_CONFIDENCE_THRESHOLD=0.85
GLOBAL_KILL_SWITCH=false

# AI Model & Multi-LLM Fallback Gateway (Free Cloud + Local Private)
MODEL_PROVIDER=groq
MODEL_OBSERVER=llama-3.3-70b-versatile
MODEL_PLANNER=llama-3.3-70b-versatile
MODEL_CRITIC=llama-3.3-70b-versatile
MODEL_EVALUATOR=llama-3.3-70b-versatile
MODEL_ADAPTER=llama-3.3-70b-versatile

# Fallback Order: Groq -> Gemini -> Ollama (Qwen) -> Mock
LLM_FALLBACK_CHAIN=["groq","gemini","ollama","mock"]
LLM_DAILY_BUDGET_USD=50.00
LLM_TIMEOUT_SECONDS=30.0

# 1. Primary: Groq (Free Cloud - console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Secondary: Google Gemini (Free Tier - aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. Tertiary: Local Ollama (100% Free, Local & Private - Qwen 2.5)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional Commercial Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Integrations Configuration & API Keys
ENABLE_MOCK_INTEGRATIONS=true
CRM_CONNECTOR_TYPE=mock          # mock | hubspot
FINANCE_CONNECTOR_TYPE=stripe      # mock | stripe
SUPPORT_CONNECTOR_TYPE=github      # mock | zendesk
EMAIL_CONNECTOR_TYPE=resend       # mock | resend | sendgrid
MARKETING_CONNECTOR_TYPE=mock    # mock | google_ads

# Stripe (Finance)
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email - Resend (Recommended, Instant Setup)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# Email - SendGrid (Alternative)
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=ops@yourcompany.com

# Zendesk (Customer Support)
ZENDESK_SUBDOMAIN=yourcompany
ZENDESK_EMAIL=admin@yourcompany.com
ZENDESK_API_TOKEN=zd_token_...

# HubSpot (CRM)
HUBSPOT_ACCESS_TOKEN=pat-na1-...

# Google Ads (Marketing)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# CORS & Server
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
HOST=0.0.0.0
PORT=8000

# Telemetry & Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=autonomous-ai-ops-manager
